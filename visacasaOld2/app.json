{
  "expo": {
    "name": "Visacasa",
    "slug": "visacasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/visacasa2.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/visacasa2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/visacasa2.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para calcular a distância até o fornecedor."
      }
    },
    "android": {
      "package": "com.mpatricio.visacasa",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBCd2afNAEQpZLZzRvTKAC7t-aQQEyMxNA"
        }
      },
      "icon": "./assets/visacasa2.png",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/visacasa2.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/visacasa2.png"
    },
    "extra": {
      "eas": {
        "projectId": "788966d7-889d-41c2-b35c-85a48359b8d7"
      }
    },
    "owner": "mpatricio"
  }
}
